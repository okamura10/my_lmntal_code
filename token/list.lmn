



// 常に引数0のほうに進む
{
    head="->"([1,2,3,4]).
    r@@
    A="->"([H|T]) :- A=[H|"->"(T)].
    return@@
    A="->"([]) :- []="->"(A).
    l@@
    A=[H|T], B="->"(T) :- C=[H|B],C="->"(A).
    next@@
    C="->"(head) :-C=head,ok.
}.

{ ok, $p[], @p}:- { // "->"は0のほうに、"<-"は1のほうに進む
    head="->"([1,2,3,4]).
    r@@
    A="->"([H|T]) :- A=[H|"->"(T)].
    return@@
    A="->"([]) :- A="<-"([]).
    l@@
    A=[H|"<-"(T)] :- A="<-"([H|T]).
    next@@
    head="<-"(C) :- head(C) ,ok2.
}.
