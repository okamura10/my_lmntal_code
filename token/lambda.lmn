 //input
 init(res).
 
 R = fiv :- R = lambda(cp(X0, cp(X1, cp(X2, cp(X3, X4)))), lambda(Y, app(X0, app(X1, app(X2, app(X3, app(X4, Y))))))).
 R = for :- R = lambda(cp(X0, cp(X1, cp(X2, X3))), lambda(Y, app(X0, app(X1, app(X2, app(X3, Y)))))).
 R = thr :- R = lambda(cp(X0, cp(X1, X2)), lambda(Y, app1(X0, app2(X1, app3(X2, Y))))).
 R = two :- R = lambda(cp(X0, X1), lambda(Y, app(X0, app(X1, Y)))).
 R = id :- R = lambda(X, X).
 
 
init(R) :- 
R = down(app(two, two)).
 
 //basci rules
 R = down(lambda(A,B)) :- R = up(lambda(A,B)). 
 R = down(app(A,B)) :- R = at(down(A),B).
 R = at(up(A),B) :- R = at(A,B).
 R = at(lambda(A,B),C) :- R = down(B), A = C.
 
 //epsilon rules
 eps(lambda(A,B)) :- eps(A), eps(B).
 eps(app(A,B)) :- eps(A), eps(B).
 eps(at(A,B)) :- eps(A), eps(B).
 eps(down(A)) :- eps(A).
 eps(up(A)) :- eps(A).
 
 //copy rules
 R = cp(A,B), R = lambda(C,D) :-  
 	A = lambda(V,W), B = lambda(X,Y), C = del(V,X), D = del(W,Y).
 R = cp(A,B), R = app(C,D) :- 
 	A = app(V,W), B = app(X,Y), C = cp(V,X), D = cp(W,Y).
 R = cp(A,B), R = at(C,D) :- 
 	A = at(V,W), B = at(X,Y), C = cp(V,X), D = cp(W,Y).
 R = cp(A,B), R = del(C,D) :- 
 	A = del(V,W), B = del(X,Y), C = cp(V,X), D = cp(W,Y).
 
 
 //delta rules
 R = del(A,B), R = lambda(C,D) :- 
 	A = lambda(V,W), B = lambda(X,Y), C = del(V,X), D = del(W,Y).
 R = del(A,B), R = app(C,D) :- 
 	A = app(V,W), B = app(X,Y), C = del(V,X), D = del(W,Y).
 R = del(A,B), R = at(C,D) :- 
 	A = at(V,W), B = at(X,Y), C = del(V,X), D = del(W,Y).
 R = del(A,B), R = del(C,D) :- 
 	A = C, B = D.
