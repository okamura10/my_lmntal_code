//3917

// 381
gen($n,$max,Ns,R),sift(A,B,C,R) :- $n > $max | Ns=[],sift(A,B,C).
gen($n,$max,Ns,R) :- $n =<$max |
    Ns=[$n|Ns1], N1=$n+1, gen(N1,$max,Ns1,R).

sift($max,[],Zs) :- int($max) | Zs=[].
sift($max,[$p|Xs],Zs) :- $p*$p<$max  |
    Zs=[$p|Zs1], filter($p,Xs,Ys,R), sift($max,Ys,Zs1,R).
sift($max,[$p|Xs],Zs) :- $p*$p>=$max |
    Zs=[$p|Zs1], sift($max,Xs,Zs1).

filter($p,[],Ys,R), sift(A,B,C,R):- int($p) | Ys=[],sift(A,B,C).
filter($p,[$x|Xs],Ys,R) :- $x mod $p=:=0 | filter($p,Xs,Ys,R).
filter($p,[$x|Xs],Ys,R) :- $x mod $p=\=0 |
    Ys=[$x|Ys1], filter($p,Xs,Ys1,R).

primes($max,Ps) :- int($max) |
    gen(2,$max,Ns,R), sift($max,Ns,Ps,R).

primes(20,answer).