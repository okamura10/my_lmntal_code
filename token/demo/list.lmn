% List permutation a la Prolog
% Nondeterministic execution computes all solutions.

% choose(X, [Y|L0],L1) :- L1=[Y|L], choose(X,L0,L).
% choose(X0,[X|L], L0) :- X0=X, L0=L.

% choose(X,[a,b,c],Y), result(X,Y).
% result(ins(a,ins(b,ins(c,[])))). 
//% ins(a,[b,c,d],res).
//
i1@@ins(X,[Y|L0],L1) :- L1=[Y|L], ins(X,L0,L).
i2@@ins(X,L0,L ) :- L=[X|L0].

p1@@perm([],L) :- L=[].
p2@@perm([X|L0],L) :- perm(L0,L1), ins(X,L1,L).

//perm([a,b,c,c,c],L), result(L).

//

% "->"(choose(X, [Y|L0],L1)) :- L1=[Y|L], "->"(choose(X,L0,L)).
% "->"(choose(X0,[X|L], L0)) :- X0=X, L0=L.

% "->"(choose(X,[a,b,c],Y)), result(X,Y).
