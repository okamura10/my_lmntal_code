% Nondeterministic Bubblesort
% res=[3,1,7,0,5,4,2].
% r=[9,6,2,7,1,4,10,8,5,3].

// もとの命令
% L=[$x,$y|L2] :- $x > $y | L=[$y,$x|L2].

result="->"([3,1,7,0,5,4,2,0]).


// 綺麗にかけた
L="->"([$x,$y|L2]) :- $x > $y | L="<-"([$y, $x|L2]).

L=[X|"<-"(L2)] :- L="<-"([X|L2]).                     //pass
result="<-"(L) :- result="->"(L).                     //fun
L="->"([$x,$y|L2]) :- $x =< $y| L=[$x|"->"([$y|L2])]. //pass
A="->"([X|'[]']) :- A=[X|'[]'].                       //fin


