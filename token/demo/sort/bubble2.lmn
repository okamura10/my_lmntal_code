% Nondeterministic Bubblesort
% res=[3,1,7,0,5,4,2].
% r=[9,6,2,7,1,4,10,8,5,3].

// もとの命令
% L=[$x,$y|L2] :- $x > $y | L=[$y,$x|L2].

result="->"([9,6,2,7,1]).

// "<-"通過分が無駄だけど、これが一番近いはず

% L="->"([$x,$y|L2]) :- $x > $y | L=[$y|"->"([$x|L2])].

% re1@@ L="->"([X|[]]) :- | L="<-"("<-fin"([X|[]])).          //return
% re2@@ L="->"([X|"<-fin"(L2)]) :- | L="<-"("<-fin"([X|L2])). //return
% fu@@  result="<-"(L) :- result="->"(L).                     //function?
% pa1@@ L=[X|"<-"(L2)] :- L="<-"([X|L2]).                     //pass
% pa2@@ L="->"([$x,$y|L2]) :- $x =< $y| L=[$x|"->"([$y|L2])]. //pass
% fin@@ result="->"("<-fin"(L2)):-result=L2.                  //fin

// % // "<-"通過分を飛ばしたいのでハイパートークンにする
 L="->"([$x,$y|L2],R) :- $x > $y | L=[$y|"->"([$x|L2],R)].

start@@ L1="->"(L2) :- L1=start(R,"->"(L,R)).
pa1@@ L="->"([$x,$y|L2],R) :- $x =< $y| L=[$x|"->"([$y|L2],R)]. 
re1@@ L="->"([X|[]],R),start(R,L2) :- L=("<-fin"([X|[]])),start(R,"->"(L2,R)). 1
re2@@ L="->"([X|"<-fin"(L2)],R),start(R,L3) :- L=("<-fin"([X|L2])),start(R,"->"(L3,R)).  //return2
fin@@ L=start(R,"->"("<-fin"(L2),R)):-L=L2.
