// % // できるだけ機械的にやりたい
// 最外戦略
// もう少し簡潔に書けないかなあ

% gen($n,$max,Ns) :- $n > $max | Ns=[].
% gen($n,$max,Ns) :- $n =<$max,$n1=$n+1 |
%     Ns=[$n|Ns1], N1=$n1, gen(N1,$max,Ns1).

% sift($max,[],Zs) :- int($max) | Zs=[].
% sift($max,[$p|Xs],Zs) :- $p*$p<$max  |
%     Zs=[$p|Zs1], filter($p,Xs,Ys), sift($max,Ys,Zs1).
% sift($max,[$p|Xs],Zs) :- $p*$p>=$max |
%     Zs=[$p|Zs1], sift($max,Xs,Zs1).

% filter($p,[],Ys) :- int($p) | Ys=[].
% filter($p,[$x|Xs],Ys) :- $x mod $p=:=0 | filter($p,Xs,Ys).
% filter($p,[$x|Xs],Ys) :- $x mod $p=\=0 |
%     Ys=[$x|Ys1], filter($p,Xs,Ys1).

% primes($max,Ps) :- int($max) |
%     gen(2,$max,Ns), sift($max,Ns,Ps).

% primes(20,answer).


// fin :  終了処理(先頭か末端かは例題に依る)
// pass:  反応に出てこない組み合わせをそのまま通過する処理
// func:  関数と見做しているものに<-で会ったら、->にして関数にくっつける

% fin@@ answer("<-"(L)) :- answer(L).                   //fin
fu1@@ Ys=sift(M,"<-"(Xs)) :- Ys="->"(sift(M,Xs)).     //function
fu2@@ Ys=filter(P,"<-"(Xs)) :- Ys="<-"(filter(P,Xs)). //function
pa1@@ Ys=[A|"<-"(Xs)] :- Ys="<-"([A|Xs]).             //pass
pa2@@ Ys="->"(filter(P,filter(P2,Xs))) :- Ys=filter(P,"->"(filter(P2,Xs))). //pass
pa3@@ Ys="->"(filter(P,gen(N,Max))) :- Ys=filter(P,"->"(gen(N,Max))).       //pass
pa4@@ Ys="->"(sift(M,filter(P,Xs))) :- Ys=sift(M,"->"(filter(P,Xs))).       //siftからのfilter呼び出しの代わり
fi1@@ Ys="fin->"("<-"([A|Xs])) :- Ys=[A|"fin->"("->"(Xs))].
pa5@@ Ys="fin->"("<-"(sift(M,Xs))) :- Ys="fin->"("->"(sift(M,Xs))).
pa6@@ Ys="->"(sift(M,gen(N,Max))) :- Ys=sift(M,"->"(gen(N,Max))).       //pass
fin@@ Ys="fin->"("<-"([])) :- Ys=[].

Ns="->"(gen($n,$max)) :- $n > $max | Ns="<-"([]).
Ns="->"(gen($n,$max)) :- $n =<$max, $n1=$n+1 |
    Ns=[$n|Ns1], N1=$n1, Ns1="<-"(gen(N1,$max)).                        //ここの向き

Zs="->"(sift($max,[])) :- int($max) | Zs="<-"([]).
Zs="->"(sift($max,[$p|Xs])) :- $p*$p<$max  |
    Zs=[$p|Zs1], Zs1="<-"(sift($max,Ys)), Ys=filter($p,Xs).             //siftからのfilter呼び出しをしない
Zs="->"(sift($max,[$p|Xs])) :- $p*$p>=$max |
    Zs=[$p|Zs1], Zs1="<-"(sift($max,Xs)).                               //siftだけは誤終了しちゃう

Ys="->"(filter($p,[])) :- int($p) | Ys="<-"([]).
Ys="->"(filter($p,[$x|Xs])) :- $x mod $p=:=0 | Ys="<-"(filter($p,Xs)).
Ys="->"(filter($p,[$x|Xs])) :- $x mod $p=\=0 |
    Ys=[$x|Ys1], Ys1="<-"(filter($p,Xs)).                               //ここの向き

primes($max,Ps) :- int($max) |
    Ns=gen(2,$max), Ps="fin->"("->"(sift($max,Ns))).

primes(10,answer).
