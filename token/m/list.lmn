// B = ins(D,node(F, L, R)) :- D < F | B = node(F, ins(D,L), R).    %右部分木
// B = ins(D,node(F, L, R)) :- D > F | B = node(F, L , ins(D,R)).   %左部分木
// B = ins(D,node(F, L, R)) :- D = F | B = node(F, L, R),  fail(ins,D). %使用済み
