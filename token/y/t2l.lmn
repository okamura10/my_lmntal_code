t(a,b,c), token(10).
 
 t(H,T,R), token(N) :- 
 	N>0, N1=N-1|
 	n(H1, t(H,H1), t(T1,T), T1, R), token(N1).
 t(H,T,R), token(0) :- l(H,T,R), token(0).