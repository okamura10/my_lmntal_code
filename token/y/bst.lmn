// % // 生成したグラフ
//head(node(6,node(2,node(0,nil,node(1,nil,nil)),node(4,node(3,nil,nil),node(5,nil,nil))),node(9,node(7,nil,node(8,nil,nil)),node(10,nil,node(11,nil,nil))))).

 % // yamada式型検査
{
 start.
 /* input graph */
 head(node(6,node(2,node(0,nil,node(1,nil,nil)),node(4,node(3,nil,nil),node(5,nil,nil))),node(9,node(7,nil,node(8,nil,nil)),node(10,nil,node(11,nil,nil))))).

 initialize @@
 start, head(INP) :-
 head(goal(token(INP, end, RTN), RTN)).

 rule1 @@
 R = token(node($x,LEFT,RIGHT), end, RTN1) :-
	 int($x) |
		 R = node($x,
		 token(LEFT, end, RTN2, -99999999, $x),
		 token(RIGHT, RTN2, RTN1, $x, 99999999)).



 rule2 @@
 R = token(nil, end, RTN) :- R = nil, RTN = end.

 rule3 @@
 R = token(node($x,LEFT,RIGHT), end, RTN1, $l, $r) :-
	 $l =< $x, $x < $r|
		 R = node($x,
		 token(LEFT, end, RTN2, $l, $x),
		 token(RIGHT, RTN2, RTN1, $x, $r)).

 rule4 @@
 R = token(nil, end, RTN, $l, $r) :-
	 int($l), int($r) |
		 R = nil, RTN = end.

 }.
goal @@
 {head(goal(INP,end)), $p[INP], @p} :- ok.


